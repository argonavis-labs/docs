{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Runner",
  "colors": {
    "primary": "#55645D",
    "light": "#7B8C84",
    "dark": "#28322F"
  },
  "favicon": "/images/runner-logo.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Connections",
            "pages": [
              "connections/connect-your-own-mcp"
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "development"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://runner.now",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/argonavis-labs/runner-electron",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/runner-docs-light.svg",
    "dark": "/logo/runner-docs-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@runner.now"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Runner",
      "href": "https://runner.now"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/argonavis-labs/runner-electron"
    }
  }
}
