{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Runner Learning Hub",
  "colors": {
    "primary": "#55645D",
    "light": "#7B8C84",
    "dark": "#28322F"
  },
  "favicon": "/images/runner-favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Welcome",
            "pages": ["index"]
          },
          {
            "group": "Coming from Runner Desktop?",
            "pages": ["legacy/runner-desktop"]
          },
          {
            "group": "Get Started",
            "pages": [
              "quickstart",
              "get-started/connecting-accounts",
              "get-started/projects",
              "get-started/runner-on-your-phone"
            ]
          }
        ]
      },
      {
        "tab": "Using Runner",
        "groups": [
          {
            "group": "Basics",
            "pages": [
              "using-runner/chatting"
            ]
          },
          {
            "group": "Runners (frmly: Automations)",
            "pages": [
              "runners/overview",
              "runners/heartbeat-and-daily-brief",
              "runners/create-your-own"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/overview",
              "workflows/starter-workflows"
            ]
          },
          {
            "group": "Memory & Models",
            "pages": [
              "using-runner/memory",
              "using-runner/models"
            ]
          }
        ]
      },
      {
        "tab": "Tips & Best Practices",
        "groups": [
          {
            "group": "Tips & Best Practices",
            "pages": [
              "tips/tips-and-tricks",
              "tips/best-practices"
            ]
          },
          {
            "group": "Share Runner",
            "pages": [
              "tips/referral-program"
            ]
          }
        ]
      },
      {
        "tab": "Use Cases",
        "groups": [
          {
            "group": "Use Cases",
            "pages": [
              "use-cases/overview"
            ]
          },
          {
            "group": "For Your Role",
            "pages": [
              "use-cases/founders",
              "use-cases/sales-and-revops",
              "use-cases/marketing-and-growth",
              "use-cases/finance-and-ops",
              "use-cases/product-and-engineering",
              "use-cases/real-estate-agents",
              "use-cases/personal-and-family"
            ]
          }
        ]
      },
      {
        "tab": "Advanced",
        "groups": [
          {
            "group": "Advanced",
            "pages": [
              "connections/tool-permissions",
              "connections/connect-your-own-mcp"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "redirects": [
    {
      "source": "/get-started/installation",
      "destination": "/legacy/runner-desktop"
    },
    {
      "source": "/get-started/workspaces",
      "destination": "/get-started/projects"
    },
    {
      "source": "/workflows/creating-automations",
      "destination": "/runners/overview"
    },
    {
      "source": "/heartbeat/overview",
      "destination": "/runners/heartbeat-and-daily-brief"
    }
  ],
  "logo": {
    "light": "/images/runner-logo-light.svg",
    "dark": "/images/runner-logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Runner",
      "href": "https://app.runner.now"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://runner.now"
    }
  },
  "feedback": {
    "thumbsRating": true
  },
  "search": {
    "prompt": "Ask or search..."
  }
}
